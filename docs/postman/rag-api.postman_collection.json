{
  "info": {
    "_postman_id": "9022256c-fd58-4495-828c-7c02a9ea77e7",
    "name": "RAG API",
    "description": "健康档案 RAG：8 个请求（基础 4 / 检索问答 3 / Agent 1），/api/query 上 4 条断言（状态码 / answer / sources / 响应时间）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "基础",
      "item": [
        {
          "name": "01 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health",
            "description": "返回 chunks、向量模型、是否离线模式。"
          },
          "response": []
        },
        {
          "name": "02 知识库状态",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/status",
            "description": "切片参数、检索配置、已入库文档。"
          },
          "response": []
        },
        {
          "name": "03 模型供应商",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/providers",
            "description": "各供应商 Key 配置情况。"
          },
          "response": []
        },
        {
          "name": "04 文档列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/documents",
            "description": "按文件聚合的 chunk 数、页码、患者。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "检索与问答",
      "item": [
        {
          "name": "05 仅检索",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"李四六对什么药物过敏？\",\n  \"top_k\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/retrieve",
            "description": "只检索不生成，返回带分数的片段。"
          },
          "response": []
        },
        {
          "name": "06 RAG 问答",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"张三九的空腹血糖是多少？\",\n  \"top_k\": 4,\n  \"provider\": \"mock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/query",
            "description": "检索 + 生成。显式指定 provider=mock，接口回归不依赖外部模型；真实模型质量由 evals/runner --online 覆盖。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"有 answer\", () => pm.expect(pm.response.json()).to.have.property(\"answer\"));",
                  "pm.test(\"有 sources\", () => pm.expect(pm.response.json().sources).to.be.an(\"array\"));",
                  "pm.test(\"响应 < 15000ms\", () => pm.expect(pm.response.responseTime).to.be.below(15000));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 流式问答（SSE）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"张三九的空腹血糖是多少？\",\n  \"top_k\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/query/stream",
            "description": "返回 retrieval / token / done 三类事件。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Agent",
      "item": [
        {
          "name": "08 Agent 问答",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"张三九的空腹血糖是多少？\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/agent/chat",
            "description": "LangGraph 工具调用；返回 thread_id / answer / tool_calls。"
          },
          "response": []
        }
      ]
    }
  ]
}