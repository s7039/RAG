# ---------------------------------------------------------------------------
# 健康档案私有知识库 RAG —— 环境变量示例
# 复制为 .env 后按需修改；没有配置任何 API Key 时，应用会自动使用
# 「本地哈希向量 + 离线模拟模型」，整条链路依然可以跑通。
# ---------------------------------------------------------------------------

# ---------- 应用 ----------
APP_NAME=健康档案私有知识库 RAG
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------- 数据路径 ----------
# 健康档案文档目录（相对项目根目录或绝对路径）
INPUT_DIR=input
# 向量库持久化目录
PERSIST_DIR=data/chroma
COLLECTION_NAME=health_records

# ---------- 文档切分 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=30

# ---------- 检索 ----------
# hybrid = 向量召回 + BM25 关键词召回加权融合；vector = 纯向量检索
RETRIEVE_MODE=hybrid
# 融合权重：alpha 越大越依赖向量语义，越小越依赖关键词
HYBRID_ALPHA=0.5
# BM25 分数软饱和尺度，越小越严格
HYBRID_KW_SCALE=6.0
TOP_K=4
FETCH_K=20
USE_MMR=false
MMR_LAMBDA=0.6
SCORE_THRESHOLD=0.0

# ---------- 生成 ----------
MAX_CONTEXT_CHARS=6000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
DEFAULT_PROVIDER=deepseek
# 想固定某个模型时填写，例如 deepseek-chat / gpt-4o-mini
DEFAULT_MODEL=

# ---------- 向量化 ----------
# auto = 有 OPENAI_API_KEY 就用 OpenAI，否则用本地哈希向量
# openai / custom / local
EMBED_PROVIDER=auto
EMBED_BATCH_SIZE=64
LOCAL_EMBED_DIM=1024

# ---------- DeepSeek ----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- 任意 OpenAI 兼容服务（可选）----------
# 例如：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1
#      Moonshot  https://api.moonshot.cn/v1
#      本地 Ollama http://127.0.0.1:11434/v1
# CUSTOM_LABEL=通义千问
# CUSTOM_API_KEY=sk-xxx
# CUSTOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CUSTOM_CHAT_MODEL=qwen-plus
# CUSTOM_EMBEDDING_MODEL=text-embedding-v3

# ---------- 兜底 ----------
# 没有可用 Key 时，是否允许使用离线模拟模型（方便演示）
ALLOW_MOCK_LLM=true
